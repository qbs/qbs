/*!
    \page cli-init.html
    \ingroup cli

    \title init
    \brief Creates a \QBS project from scratch.

    \section1 Synopsis

    \code
    qbs create-project [--language <language>] [--version <version>] [--depends <depends>] project-type name
    \endcode

    \section1 Description

    Sets up a \QBS project directory according to the given options and parameters. The directory
    has the same name as the project and is generated in the current working directory.

    \section1 Options

    \include cli-options.qdocinc language
    \include cli-options.qdocinc project-version
    \include cli-options.qdocinc depends
    \include cli-options.qdocinc help

    \section1 Parameters

    \include cli-parameters.qdocinc project-type
    \include cli-parameters.qdocinc project-name

    \section1 Examples

    To create a new C application:

    \code
    qbs init -c c application hello-world
    \endcode

    To create a new Qt-based library:

    \code
    qbs init -d Qt.core library mylib
    \endcode
*/
